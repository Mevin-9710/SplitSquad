PORT=3002
NODE_ENV=development

# AI API (NVIDIA NIM / OpenAI-compatible)
# For NVIDIA NIM: AI_BASE_URL=https://integrate.api.nvidia.com/v1
# For OpenAI: AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Aggregator API base URL (to fetch analytics data)
AGGREGATOR_BASE_URL=http://localhost:3001

# Obsidian Vault export path
OBSIDIAN_VAULT_PATH=../vault/SplitSquad-HQ
