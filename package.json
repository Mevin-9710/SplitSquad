{
  "name": "splitsquad",
  "version": "1.0.0",
  "description": "WhatsApp bill-splitting bot with Express backend",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./public/css/tailwind.css --minify",
    "build:js": "esbuild public/js/app.js --minify --drop:console --outfile=public/js/app.min.js && esbuild public/js/tutorial.js --minify --drop:console --outfile=public/js/tutorial.min.js",
    "build": "npm run build:css && npm run build:js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/**/*.js"
  },
  "keywords": [
    "whatsapp",
    "bill-splitting",
    "expense-sharing"
  ],
  "author": "SplitSquad",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^8.52.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "googleapis": "^172.0.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "posthog-node": "^4.5.0",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.1",
    "uuid": "^11.0.3",
    "whatsapp-web.js": "^1.34.7",
    "winston": "^3.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^3.4.15"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
