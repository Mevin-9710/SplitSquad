<!DOCTYPE html>
<html lang="en">
<head>
  <script>window.addEventListener('pageshow',function(e){if(e.persisted)location.reload()})</script>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <meta name="theme-color" content="#f4bd31"/>
  <title><%= split.description %> - SplitSquad</title>
  <link href="/app/images/S.png" rel="icon" type="image/png"/>
  <link href="/app/css/brutalist.css" rel="stylesheet"/>
  <link href="/app/css/tailwind.css" rel="stylesheet"/>
  <style>
    .brutalist-border { border: 3px solid #1a1c1c; }
    .brutalist-border-thin { border: 1px solid #1a1c1c; }
    .brutalist-shadow { box-shadow: 4px 4px 0px #1a1c1c; }
    .brutalist-shadow-sm { box-shadow: 2px 2px 0px #1a1c1c; }
    .brutalist-shadow:active { box-shadow: none; transform: translate(4px, 4px); }
    body { background-color: #f9f9f9; color: #1a1c1c; }
  </style>
  <style> body { min-height: max(884px, 100dvh); } </style>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% if (typeof analytics !== 'undefined' && analytics.gtmId) { %>
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%= analytics.gtmId %>');</script>
  <% } %>
  <% if (typeof analytics !== 'undefined' && analytics.ga4Id) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= analytics.ga4Id %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= analytics.ga4Id %>');
  </script>
  <% } %>
</head>
<body class="font-body-md bg-background min-h-screen flex flex-col pt-16 pb-20 md:pb-0 grid-bg">
  <%- include('partials/loading') %>
  <header class="fixed top-0 w-full z-50 flex justify-between items-center px-margin-mobile md:px-margin-desktop h-16 bg-surface/90 backdrop-blur-sm text-on-surface border-b-[3px] border-on-surface shadow-brutalist-sm">
    <a href="/app/" class="brutalist-border-thin p-1 hover:bg-primary-container hover:text-on-primary-container transition-colors">
      <span class="material-symbols-outlined" data-icon="arrow_back">arrow_back</span>
    </a>
    <span class="font-headline-md text-headline-md uppercase tracking-tighter">SplitSquad</span>
    <div class="w-10"></div>
  </header>
  <main class="flex-1 max-w-3xl w-full mx-auto p-margin-mobile md:p-margin-desktop space-y-4">
    <div class="brutalist-border bg-surface-container-lowest p-6 relative">
      <div class="absolute -top-3 -right-3 brutalist-border-thin bg-primary-container px-3 py-1">
        <span class="font-label-sm text-label-sm uppercase">Status: <span class="font-bold"><%= split.status.toUpperCase() %></span></span>
      </div>
      <h1 class="font-headline-lg-mobile text-headline-lg-mobile uppercase mb-4 pr-20"><%= split.description %></h1>
      <div class="space-y-3">
        <div>
          <p class="font-label-sm text-label-sm uppercase text-on-surface-variant">Created By</p>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined filled text-primary" data-icon="person">person</span>
            <span class="font-body-md text-body-md">You</span>
          </div>
        </div>
        <div>
          <p class="font-label-sm text-label-sm uppercase text-on-surface-variant">Total Amount</p>
          <p class="font-headline-md text-headline-md">₹<%= (split.total_amount / 100).toFixed(2) %></p>
        </div>
        <div class="border-t border-on-surface pt-3">
          <p class="font-label-sm text-label-sm uppercase text-on-surface-variant">Date</p>
          <p class="font-body-md text-body-md"><%= new Date(split.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
        </div>
      </div>
    </div>
    <button id="send-whatsapp" class="w-full brutalist-border brutalist-shadow bg-primary-container p-4 font-label-md text-label-md uppercase text-on-primary-fixed flex items-center justify-center gap-2 hover:bg-inverse-primary transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">
      <span class="material-symbols-outlined filled" data-icon="chat">chat</span>
      Send via WhatsApp
    </button>
    <button id="delete-split" class="w-full brutalist-border bg-surface-container-lowest p-3 font-label-sm text-label-sm uppercase text-error flex items-center justify-center gap-2 hover:bg-error-container hover:text-on-error-container transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">
      <span class="material-symbols-outlined" data-icon="delete">delete</span>
      Delete Split
    </button>
    <div class="brutalist-border" id="participants-list">
      <div class="bg-surface-container p-3 border-b-[3px] border-on-surface">
        <span class="font-label-md text-label-md uppercase">Participants (<%= split.participants.length %>)</span>
      </div>
      <% split.participants.forEach(function(p) { %>
      <div class="flex items-center gap-3 p-4 border-b-[1px] border-on-surface last:border-b-0">
        <div class="brutalist-border-thin bg-surface-container-high w-12 h-12 flex items-center justify-center flex-shrink-0">
          <span class="font-label-md text-label-md uppercase"><%= p.name.slice(0, 1).toUpperCase() %></span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-label-md text-label-md uppercase"><%= p.name %></p>
          <p class="font-label-sm text-label-sm text-on-surface-variant"><%= p.phone === 'CREATOR' ? 'You' : p.phone %></p>
        </div>
        <div class="text-right">
          <p class="font-label-md text-label-md">₹<%= (p.amount / 100).toFixed(2) %></p>
          <% const isPaid = p.settled === 1 || p.participant_verified === 1; %>
          <% const isCreator = p.phone === 'CREATOR'; %>
          <% const isMerchantMode = split.payment_mode === 'merchant_direct'; %>
          <% if (!isCreator || !isMerchantMode) { %>
          <span class="inline-block mt-1 px-2 py-0.5 font-label-sm text-label-sm uppercase <%= isPaid ? 'bg-primary-container text-on-primary-fixed' : 'bg-error text-on-error' %>"><%= isPaid ? 'PAID' : 'UNPAID' %></span>
          <% } %>
        </div>
      </div>
      <% }); %>
    </div>
    <% if (split.payment_mode === 'merchant_direct' && split.merchant_upi_id) { %>
    <div class="brutalist-border bg-surface-container-low p-4">
      <p class="font-label-md text-label-md uppercase mb-2">Merchant UPI</p>
      <p class="font-body-md text-body-md"><%= split.merchant_upi_id %></p>
      <% if (split.merchant_name) { %>
      <p class="font-label-sm text-label-sm text-on-surface-variant mt-1"><%= split.merchant_name %></p>
      <% } %>
    </div>
    <% } %>
    <div id="upi-redirect-modal" class="fixed inset-0 z-[10000] hidden items-center justify-center bg-black/50">
      <div class="brutalist-border bg-surface-container-lowest p-6 max-w-sm w-full mx-4 brutalist-shadow">
        <div class="text-center">
          <span class="material-symbols-outlined text-6xl text-primary mb-2" data-icon="payments">payments</span>
          <h2 class="font-headline-md text-headline-md uppercase mb-2">Opening UPI App</h2>
          <p class="font-body-md text-body-md mb-4">Redirecting you to pay <strong>₹<%= (split.participants.find(p => p.phone === 'CREATOR')?.amount / 100).toFixed(2) || '0.00' %></strong> to <strong><%= split.merchant_name || 'Merchant' %></strong></p>
          <div class="flex items-center justify-center gap-2 mb-4">
            <div class="w-3 h-3 bg-primary rounded-full animate-bounce"></div>
            <div class="w-3 h-3 bg-primary rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
            <div class="w-3 h-3 bg-primary rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
          </div>
          <p class="font-label-sm text-label-sm text-on-surface-variant">If the app doesn't open automatically, use the link below:</p>
          <a id="upi-fallback-link" href="#" class="brutalist-border-thin bg-primary-container px-4 py-2 font-label-sm text-label-sm uppercase text-on-primary-fixed block mt-3 hover:bg-inverse-primary transition-all truncate">Open UPI App Manually →</a>
          <button id="close-upi-modal" class="brutalist-border-thin bg-surface-container-lowest px-4 py-2 font-label-sm text-label-sm uppercase text-on-surface-variant block mt-3 w-full hover:bg-surface-variant transition-all">Close</button>
        </div>
      </div>
    </div>
  </main>
  <nav class="md:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-20 bg-surface px-2 border-t-[3px] border-on-surface">
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/">
      <span class="material-symbols-outlined filled" data-icon="home">home</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">Home</span>
    </a>
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/scan-qr">
      <span class="material-symbols-outlined" data-icon="qr_code_scanner">qr_code_scanner</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">Scanner</span>
    </a>
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/contacts">
      <span class="material-symbols-outlined" data-icon="groups">groups</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">Squad</span>
    </a>
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/qr">
      <span class="material-symbols-outlined" data-icon="chat">chat</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">WhatsApp</span>
    </a>
  </nav>
  <%- include('partials/tutorial') %>
  <script src="/app/js/analytics.js"></script>
  <script>
    (function() {
      var sa = window.SplitSquadAnalytics;
      if (!sa) return;

      sa.track('split_viewed', {
        split_id: '<%= split.id %>',
        split_type: '<%= split.payment_mode === "merchant_direct" ? "merchant_direct" : "group_bill" %>',
        participant_count: <%= split.participants.length %>
      });

      var cp = new URLSearchParams(window.location.search);
      if (cp.get('created') === '1') {
        var totalAmount = <%= split.total_amount %>;
        var eventName = cp.get('first') === '1' ? 'first_split_created' : 'split_created';
        sa.track(eventName, {
          split_type: '<%= split.payment_mode === "merchant_direct" ? "merchant_direct" : "group_bill" %>',
          participant_count: <%= split.participants.length %>,
          total_amount: Math.round(totalAmount / 100 * 100) / 100,
          currency: '<%= split.merchant_currency || "INR" %>'
        });
        window.history.replaceState({}, document.title, '/app/split/<%= split.id %>');
      }
    })();
  </script>
  <script>
    const paymentMode = '<%- split.payment_mode %>';
    const merchantUpiId = '<%- (split.merchant_upi_id || '').replace(/'/g, "\\'") %>';
    const merchantName = '<%- (split.merchant_name || "Merchant").replace(/'/g, "\\'") %>';
    const splitDescription = '<%- (split.description || "").replace(/'/g, "\\'").replace(/"/g, '\\"') %>';
    const creatorParticipant = <%- JSON.stringify(split.participants.find(p => p.phone === 'CREATOR') || null) %>;
    const creatorAmount = creatorParticipant ? (creatorParticipant.amount / 100).toFixed(2) : '0.00';
    const splitId = '<%- split.id %>';


    function generateUpiUri(options) {
      const { pa, pn, am, tn, cu = 'INR' } = options;
      if (!pa) throw new Error('UPI ID is required');
      const params = new URLSearchParams();
      params.set('pa', pa);
      if (pn) params.set('pn', pn);
      if (am) params.set('am', String(am));
      if (tn) params.set('tn', tn);
      if (cu) params.set('cu', cu);
      return `upi://pay?${params.toString()}`;
    }

    function showUpiModal() {
      const upiUrl = generateUpiUri({
        pa: merchantUpiId,
        pn: merchantName,
        am: creatorAmount,
        tn: `SplitSquad: ${splitDescription}`,
        cu: 'INR',
      });

      const modal = document.getElementById('upi-redirect-modal');
      const fallbackLink = document.getElementById('upi-fallback-link');
      fallbackLink.href = upiUrl;
      modal.classList.remove('hidden');
      modal.style.display = 'flex';

      setTimeout(() => {
        window.location.href = upiUrl;
      }, 1500);
    }

    function hideUpiModal() {
      const modal = document.getElementById('upi-redirect-modal');
      modal.classList.add('hidden');
      modal.style.display = 'none';
    }

    const closeBtn = document.getElementById('close-upi-modal');
    if (closeBtn) closeBtn.addEventListener('click', hideUpiModal);

    const deleteBtn = document.getElementById('delete-split');
    if (deleteBtn) {
      deleteBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to delete this split? This action cannot be undone.')) return;

        deleteBtn.disabled = true;
        deleteBtn.textContent = 'Deleting...';

        try {
          const res = await fetch('/api/splits/' + splitId, { method: 'DELETE' });
          const data = await res.json();

          if (data.success) {
            try { if (window.SplitSquadAnalytics) window.SplitSquadAnalytics.track('split_deleted', { split_id: splitId }); } catch(e) {}
            window.location.href = '/app/';
          } else {
            alert('Failed to delete split: ' + (data.error || 'Unknown error'));
            deleteBtn.disabled = false;
            deleteBtn.innerHTML = '<span class="material-symbols-outlined" data-icon="delete">delete</span> Delete Split';
          }
        } catch (e) {
          alert('Failed to delete split: ' + e.message);
          deleteBtn.disabled = false;
          deleteBtn.innerHTML = '<span class="material-symbols-outlined" data-icon="delete">delete</span> Delete Split';
        }
      });
    }

    function trackInviteSent() {
      try {
        if (window.SplitSquadAnalytics) {
          window.SplitSquadAnalytics.track('invite_sent', {
            method: 'whatsapp',
            split_id: splitId
          });
        }
      } catch (e) {}
    }

    function trackSettlementInitiated() {
      try {
        if (window.SplitSquadAnalytics) {
          window.SplitSquadAnalytics.track('settlement_initiated', {
            split_type: paymentMode === 'merchant_direct' ? 'merchant_direct' : 'group_bill'
          });
        }
      } catch (e) {}
    }

    function showUpiModalWithTracking() {
      trackSettlementInitiated();
      showUpiModal();
    }

    const sendBtn = document.getElementById('send-whatsapp');

    if (sendBtn) {
      sendBtn.addEventListener('click', async () => {
        sendBtn.disabled = true;
        sendBtn.textContent = 'Sending...';

        try {
          const res = await fetch('/api/splits/' + splitId + '/share', { method: 'POST' });
          const data = await res.json();

          if (data.success) {
            trackInviteSent();
            if (paymentMode === 'merchant_direct' && merchantUpiId && creatorAmount !== '0.00') {
              showUpiModalWithTracking();
            } else {
              alert('Split shared via WhatsApp!');
            }
          } else {
            const errorMsg = data.error || 'Unknown error';
            if (paymentMode === 'merchant_direct' && merchantUpiId && creatorAmount !== '0.00') {
              if (confirm('WhatsApp send failed: ' + errorMsg + '\n\nDo you still want to open UPI app to pay your share?')) {
                showUpiModal();
              }
            } else {
              alert('Failed to share: ' + errorMsg);
            }
          }
        } catch (e) {
          if (paymentMode === 'merchant_direct' && merchantUpiId && creatorAmount !== '0.00') {
            if (confirm('Network error. Do you still want to open UPI app to pay your share?')) {
              showUpiModal();
            }
          } else {
            alert('Failed to share split: ' + e.message);
          }
        } finally {
          sendBtn.disabled = false;
          sendBtn.textContent = 'Send via WhatsApp';
        }
      });
    }
  </script>
</body>
</html>
