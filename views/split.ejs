<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= split.description %> - SplitSquad</title><script src="https://cdn.tailwindcss.com"></script><script src="/js/utils/format.js"></script></head><body class="bg-gray-50 min-h-screen"><main class="max-w-2xl mx-auto px-4 py-8"><a class="text-green-600" href="/">← Back</a><h1 class="text-2xl font-bold mt-2"><%= split.description %></h1><p class="text-sm text-gray-600">Creator: <code><%= creatorName || creatorId || 'unknown' %></code></p><p class="text-sm text-gray-600">Total: <span id="split-total"></span></p><button id="send-whatsapp-btn" class="mt-3 bg-green-600 text-white px-4 py-2 rounded-lg">Send via WhatsApp</button><p id="send-status" class="text-sm mt-2"></p><div id="delivery-results" class="text-sm mt-2"></div><h2 class="text-lg font-semibold mt-6 mb-2">Participants</h2><div id="participants-list" class="space-y-2"></div></main><script>const participants=<%- JSON.stringify(split.participants) %>;document.getElementById('split-total').textContent=formatCurrency(<%= split.total_amount %>);const c=document.getElementById('participants-list');participants.forEach(p=>{const d=document.createElement('div');d.className='bg-white rounded p-2';d.textContent=`${p.name} (${p.phone}) - ${formatCurrency(p.amount)}`;c.appendChild(d);});document.getElementById('send-whatsapp-btn').addEventListener('click',async()=>{const btn=document.getElementById('send-whatsapp-btn');const status=document.getElementById('send-status');const report=document.getElementById('delivery-results');btn.disabled=true;btn.textContent='Sending...';status.textContent='';report.textContent='';try{const response=await fetch('/api/splits/<%= split.id %>/send-whatsapp',{method:'POST'});const data=await response.json();if(!response.ok){status.textContent=data.error||'Send failed';return;}status.textContent=`Delivered ${data.delivered}/${data.total}`;const failures=(data.results||[]).filter(r=>!r.success);if(failures.length){report.textContent='Failures: '+failures.map(f=>`${f.name}(${f.error})`).join(', ');}}catch{status.textContent='Failed to send WhatsApp messages.';}finally{btn.disabled=false;btn.textContent='Send via WhatsApp';}});</script></body></html>
