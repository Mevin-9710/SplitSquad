<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= split.description %> - SplitSquad</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            whatsapp: {
              DEFAULT: '#25D366',
              dark: '#128C7E',
              light: '#DCF8C6',
              hover: '#1DA851',
            },
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
        },
      },
    }
  </script>
  <style>
    .card {
      background: white;
      border-radius: 0.75rem;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      padding: 1rem;
      margin-bottom: 1rem;
    }
    .status-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 500;
    }
    .status-active {
      background-color: #FEF3C7;
      color: #92400E;
    }
    .status-settled {
      background-color: #D1FAE5;
      color: #065F46;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Header -->
  <header class="bg-gradient-to-br from-[#25D366] to-[#128C7E] text-white py-8 px-4">
    <div class="max-w-2xl mx-auto">
      <a href="/" class="inline-flex items-center text-white opacity-90 hover:opacity-100 transition-opacity">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Home
      </a>
    </div>
  </header>

  <main class="max-w-2xl mx-auto px-4 py-8">
    <!-- Split Details Card -->
    <div class="card">
      <div class="flex justify-between items-start mb-6">
        <div>
          <h1 class="text-2xl font-bold text-gray-800"><%= split.description %></h1>
          <p class="text-gray-500 text-sm mt-1">Created <span id="split-date"></span></p>
        </div>
        <div id="status-badge" class="status-badge">
          <%= split.status === 'active' ? 'Active' : 'Settled' %>
        </div>
      </div>

      <div class="bg-[#DCF8C6] rounded-xl p-4 mb-6">
        <p class="text-sm text-gray-600 mb-1">Total Amount</p>
        <p class="text-3xl font-bold text-[#128C7E]" id="split-total">Loading...</p>
      </div>
    </div>

    <!-- Participants List -->
    <div class="card">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Participants</h2>
      <div id="participants-list" class="space-y-3">
        <!-- Populated by JS -->
      </div>
    </div>

    <!-- Summary -->
    <div class="card bg-white">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Summary</h2>
      <div class="grid grid-cols-2 gap-4 text-center">
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">Total Participants</p>
          <p class="text-2xl font-bold text-gray-800" id="participant-count">-</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">Settled</p>
          <p class="text-2xl font-bold text-[#25D366]" id="settled-count">-</p>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-800 text-white py-6 px-4 mt-8">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-gray-400 text-sm">&copy; 2026 SplitSquad</p>
    </div>
  </footer>

  <script src="/js/utils/format.js"></script>
  <script>
    // Render participants from EJS data
    const participants = <%- JSON.stringify(split.participants) %>;
    const container = document.getElementById('participants-list');

    // Set date
    document.getElementById('split-date').textContent = formatDate('<%= split.createdAt %>');

    // Set totals
    document.getElementById('participant-count').textContent = participants.length;
    document.getElementById('settled-count').textContent = participants.filter(p => p.settled).length;

    // Render each participant
    participants.forEach(p => {
      const div = document.createElement('div');
      div.className = 'flex items-center justify-between p-3 bg-gray-50 rounded-lg';
      div.innerHTML = `
        <div class="flex items-center">
          <div class="w-10 h-10 bg-[#DCF8C6] rounded-full flex items-center justify-center mr-3">
            <span class="font-semibold text-[#25D366]">${p.name.charAt(0).toUpperCase()}</span>
          </div>
          <div>
            <p class="font-medium text-gray-800">${p.name}</p>
            <p class="text-sm text-gray-500">${p.phone || 'No phone'}</p>
          </div>
        </div>
        <div class="text-right">
          <p class="font-semibold text-[#128C7E]">${formatCurrency(p.amount)}</p>
          <span class="text-xs ${p.settled ? 'text-green-600' : 'text-yellow-600'}">
            ${p.settled ? '✓ Settled' : 'Pending'}
          </span>
        </div>
      `;
      container.appendChild(div);
    });
  </script>
</body>
</html>