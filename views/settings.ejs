<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - SplitSquad</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <header class="bg-green-600 text-white p-4">
    <div class="max-w-lg mx-auto flex justify-between items-center">
      <h1 class="text-xl font-bold">Settings</h1>
      <a class="text-sm underline" href="/">← Back</a>
    </div>
  </header>

  <main class="max-w-lg mx-auto px-4 py-6">
    <!-- Creator Info -->
    <section class="bg-white rounded-xl shadow-sm p-4 mb-6">
      <p class="text-sm text-gray-600">Creator: <code class="bg-gray-100 px-2 py-0.5 rounded"><%= creatorName || creatorId %></code></p>
    </section>

    <!-- UPI Profiles -->
    <section class="bg-white rounded-xl shadow-md p-5 mb-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold">Your UPI IDs</h2>
        <button type="button" id="add-upi-btn" class="bg-green-600 text-white rounded-lg px-3 py-1.5 text-sm font-medium">+ Add</button>
      </div>

      <div id="upi-list" class="space-y-3">
        <div class="text-center py-8 text-gray-400" id="upi-empty">
          <p>No UPI IDs saved yet.</p>
          <p class="text-sm mt-1">Add your UPI ID to receive payments automatically.</p>
        </div>
      </div>
    </section>

    <!-- Test UPI Link -->
    <section class="bg-white rounded-xl shadow-md p-5 mb-6">
      <h2 class="text-lg font-semibold mb-3">Test UPI Link</h2>
      <div class="flex gap-2">
        <input type="text" id="test-upi-id" placeholder="Enter UPI ID to test" class="border rounded-lg px-3 py-2 flex-1 text-sm">
        <button type="button" id="test-upi-btn" class="bg-green-600 text-white rounded-lg px-4 py-2 text-sm font-medium">Test</button>
      </div>
      <p class="text-xs text-gray-500 mt-2">Opens a UPI payment of ₹1 to test if the link works with your UPI apps.</p>
    </section>

    <div id="status-msg" class="text-sm text-center"></div>
  </main>

  <!-- Add UPI Modal -->
  <div id="add-upi-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl p-6 w-full max-w-sm">
      <h3 class="text-lg font-semibold mb-4">Add UPI ID</h3>
      <form id="add-upi-form" class="space-y-3">
        <div>
          <input type="text" id="new-upi-id" placeholder="e.g., rahul@oksbi" class="border rounded-lg px-3 py-2 w-full" required>
          <p class="text-xs text-gray-500 mt-1">Format: name@bank (e.g., rahul@oksbi, 9876543210@ybl)</p>
          <p id="upi-validation-error" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>
        <div>
          <input type="text" id="new-upi-label" placeholder="Label (e.g., SBI, PhonePe)" class="border rounded-lg px-3 py-2 w-full">
        </div>
        <div class="flex gap-2">
          <button type="submit" class="flex-1 bg-green-600 text-white rounded-lg px-4 py-2 font-medium">Save</button>
          <button type="button" id="cancel-add-upi" class="flex-1 border rounded-lg px-4 py-2 font-medium">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Label Modal -->
  <div id="edit-label-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl p-6 w-full max-w-sm">
      <h3 class="text-lg font-semibold mb-4">Edit Label</h3>
      <form id="edit-label-form" class="space-y-3">
        <input type="text" id="edit-label-input" placeholder="Label" class="border rounded-lg px-3 py-2 w-full" required>
        <input type="hidden" id="edit-label-id">
        <div class="flex gap-2">
          <button type="submit" class="flex-1 bg-green-600 text-white rounded-lg px-4 py-2 font-medium">Save</button>
          <button type="button" id="cancel-edit-label" class="flex-1 border rounded-lg px-4 py-2 font-medium">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script type="module" src="/js/settings.js"></script>
</body>
</html>
