<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SplitSquad - Split Bills with WhatsApp</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            whatsapp: {
              DEFAULT: '#25D366',
              dark: '#128C7E',
              light: '#DCF8C6',
              hover: '#1DA851',
            },
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
        },
      },
    }
  </script>
  <style>
    .btn-whatsapp {
      background-color: #25D366;
      color: white;
      font-weight: 500;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      transition: background-color 0.2s;
    }
    .btn-whatsapp:hover {
      background-color: #1DA851;
    }
    .card {
      background: white;
      border-radius: 0.75rem;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      padding: 1rem;
      margin-bottom: 1rem;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Hero Section -->
  <header class="bg-gradient-to-br from-[#25D366] to-[#128C7E] text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="flex items-center justify-center mb-6">
        <img src="/images/logo.svg" alt="SplitSquad" class="w-16 h-16 mr-4">
        <h1 class="text-4xl font-bold">SplitSquad</h1>
      </div>
      <p class="text-xl opacity-90">Split bills with your WhatsApp group</p>
    </div>
  </header>

  <!-- Recent Splits Section -->
  <main class="max-w-4xl mx-auto px-4 py-8">
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Recent Splits</h2>

    <div id="splits-container" class="space-y-4">
      <!-- Loading state -->
      <div class="text-center py-8 text-gray-500">
        <div class="animate-pulse">
          <div class="h-4 bg-gray-200 rounded w-3/4 mx-auto mb-4"></div>
          <div class="h-4 bg-gray-200 rounded w-1/2 mx-auto"></div>
        </div>
        <p class="mt-4">Loading splits...</p>
      </div>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-12">
      <div class="bg-white rounded-xl shadow-md p-8">
        <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
        </svg>
        <h3 class="text-lg font-medium text-gray-700 mb-2">No splits yet</h3>
        <p class="text-gray-500">Create your first bill split from your WhatsApp group!</p>
      </div>
    </div>

    <!-- How to Use Section -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6">How It Works</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl shadow-md p-6 text-center">
          <div class="w-12 h-12 bg-[#DCF8C6] rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold text-[#25D366]">1</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Send to Bot</h3>
          <p class="text-gray-600 text-sm">Message your split details to the WhatsApp bot</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-6 text-center">
          <div class="w-12 h-12 bg-[#DCF8C6] rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold text-[#25D366]">2</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Add Participants</h3>
          <p class="text-gray-600 text-sm">Tag members in your WhatsApp group</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-6 text-center">
          <div class="w-12 h-12 bg-[#DCF8C6] rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold text-[#25D366]">3</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Track & Settle</h3>
          <p class="text-gray-600 text-sm">Monitor who owes what and mark as settled</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-800 text-white py-8 px-4 mt-12">
    <div class="max-w-4xl mx-auto text-center">
      <div class="flex items-center justify-center mb-4">
        <img src="/images/logo.svg" alt="SplitSquad" class="w-8 h-8 mr-2">
        <span class="font-semibold">SplitSquad</span>
      </div>
      <p class="text-gray-400 text-sm">Split bills easily with your WhatsApp group</p>
      <p class="text-gray-500 text-xs mt-4">&copy; 2026 SplitSquad</p>
    </div>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>