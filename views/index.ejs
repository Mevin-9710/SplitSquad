<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SplitSquad</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <header class="bg-green-600 text-white p-6">
    <div class="max-w-4xl mx-auto flex justify-between items-center">
      <h1 class="text-2xl font-bold">SplitSquad</h1>
      <div class="text-sm text-right">
        <div>Creator: <code><%= creatorName || creatorId %></code> | <a class="underline" href="/connect">Connect WhatsApp</a></div>
        <div class="mt-1">
          <span class="<%= whatsappConnected ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-900' %> px-2 py-1 rounded text-xs font-semibold"><%= whatsappConnected ? 'Connected' : 'Not Connected' %></span>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-8">
    <section class="bg-white rounded-xl shadow-sm p-4 mb-6">
      <form method="GET" action="/" class="flex gap-2 items-center">
        <input name="creatorName" placeholder="Set creator name" value="<%= creatorName || '' %>" class="border rounded px-3 py-2 flex-1">
        <button type="submit" class="bg-green-600 text-white rounded px-4 py-2">Save Name</button>
      </form>
    </section>

    <% if (!whatsappConnected) { %>
    <section class="bg-green-50 border border-green-200 rounded-xl shadow-sm p-6 mb-8">
      <h2 class="text-xl font-semibold mb-2">Connect Your WhatsApp First</h2>
      <p class="text-sm text-gray-700 mb-4">Each creator must connect their own WhatsApp before sending split messages.</p>
      <a href="/connect" class="inline-block bg-green-600 text-white rounded-lg px-4 py-2 font-medium">Open QR Connect Page</a>
    </section>
    <% } %>

    <section class="mb-6">
      <a href="/contacts" class="inline-flex items-center gap-2 bg-white border border-green-600 text-green-600 rounded-xl shadow-sm px-5 py-3 font-medium hover:bg-green-50 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        Manage Participants
      </a>
    </section>

    <section class="bg-white rounded-xl shadow-md p-6 mb-8">
      <h2 class="text-xl font-semibold mb-3">Create Split</h2>
      <form id="create-split-form" class="space-y-4">
        <input id="description" type="text" placeholder="Description" class="border rounded-lg px-3 py-2 w-full" required>
        <input id="total-amount" type="number" step="0.01" min="0.01" placeholder="Total Amount (₹)" class="border rounded-lg px-3 py-2 w-full" required>

        <div id="selected-participants" class="space-y-2"></div>

        <button type="button" id="open-participants-dialog" class="w-full border-2 border-dashed border-gray-300 rounded-lg px-4 py-3 text-gray-500 hover:border-green-500 hover:text-green-600 transition-colors flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Add Participants
        </button>

        <button type="submit" class="bg-green-600 text-white rounded-lg px-4 py-2 w-full">Create Split</button>
        <p id="create-split-status" class="text-sm text-gray-600"></p>
      </form>
    </section>

    <h2 class="text-xl font-semibold mb-3">Your Recent Splits</h2>
    <div id="splits-container"></div>
    <div id="empty-state" class="hidden text-gray-500">No splits yet.</div>
  </main>

  <!-- Participants Selection Dialog -->
  <div id="participants-dialog" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl w-full max-w-lg max-h-[85vh] flex flex-col">
      <div class="flex justify-between items-center p-4 border-b">
        <h3 class="text-lg font-semibold">Select Participants</h3>
        <button type="button" id="close-dialog" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="flex gap-1 border-b px-4 pt-2">
        <button type="button" class="dialog-tab px-3 py-2 text-sm font-medium border-b-2 border-green-600 text-green-600" data-category="friends">Friends</button>
        <button type="button" class="dialog-tab px-3 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500" data-category="family">Family</button>
        <button type="button" class="dialog-tab px-3 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500" data-category="co-workers">Co-workers</button>
      </div>

      <div class="flex-1 overflow-y-auto p-4">
        <div class="dialog-panel" data-category="friends"></div>
        <div class="dialog-panel hidden" data-category="family"></div>
        <div class="dialog-panel hidden" data-category="co-workers"></div>
      </div>

      <div class="border-t p-4 space-y-2">
        <div id="dialog-selected-count" class="text-sm text-gray-500">0 selected</div>
        <div class="flex gap-2">
          <button type="button" id="dialog-add-selected" class="flex-1 bg-green-600 text-white rounded-lg px-4 py-2 font-medium">Add Them</button>
          <button type="button" id="dialog-add-from-contacts" class="flex-1 border border-green-600 text-green-600 rounded-lg px-4 py-2 font-medium">Add from Contacts</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
