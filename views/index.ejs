<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <meta name="theme-color" content="#f4bd31"/>
  <script>window.addEventListener('pageshow',function(e){if(e.persisted)location.reload()})</script>
  <title>SplitSquad</title>
  <link href="/app/images/S.png" rel="icon" type="image/png"/>
  <link href="/app/manifest.json" rel="manifest"/>
  <link href="/app/css/brutalist.css" rel="stylesheet"/>
  <link href="/app/css/tailwind.css" rel="stylesheet"/>
  <style>
    .brutalist-border { border: 3px solid #1a1c1c; }
    .brutalist-border-thin { border: 1px solid #1a1c1c; }
    .brutalist-shadow { box-shadow: 4px 4px 0px #1a1c1c; }
    .brutalist-shadow-sm { box-shadow: 2px 2px 0px #1a1c1c; }
    .brutalist-shadow:active { box-shadow: none; transform: translate(4px, 4px); }
    body { background-color: #f9f9f9; color: #1a1c1c; }
  </style>
  <style>
    body { min-height: max(884px, 100dvh); }
  </style>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Google Tag Manager -->
  <% if (typeof analytics !== 'undefined' && analytics.gtmId) { %>
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%= analytics.gtmId %>');</script>
  <% } %>
  <!-- Google Analytics 4 -->
  <% if (typeof analytics !== 'undefined' && analytics.ga4Id) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= analytics.ga4Id %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= analytics.ga4Id %>');
  </script>
  <% } %>
</head>
<body class="font-body-md bg-background min-h-screen flex flex-col pt-16 pb-20 md:pb-0 grid-bg">
  <%- include('partials/loading') %>
  <header class="fixed top-0 w-full z-50 flex justify-between items-center px-margin-mobile md:px-margin-desktop h-16 bg-surface/90 dark:bg-surface/90 backdrop-blur-sm text-on-surface border-b-[3px] border-on-surface shadow-brutalist-sm">
    <div class="flex items-center gap-2">
      <span class="w-8 h-8 bg-primary-container brutalist-border-thin flex items-center justify-center font-headline-md text-sm font-bold text-on-surface">S</span>
      <span class="font-headline-md text-headline-md-mobile text-headline-md tracking-tighter text-on-surface uppercase">SplitSquad</span>
    </div>
    <a href="/app/settings" class="hover:bg-primary-container hover:text-on-primary-container p-2 brutalist-border-thin rounded-none transition-colors">
      <span class="material-symbols-outlined" data-icon="settings">settings</span>
    </a>
  </header>
  <div id="pwa-install-banner" class="hidden fixed top-16 left-0 right-0 z-40 bg-primary-container border-b-[3px] border-on-surface px-margin-mobile md:px-margin-desktop py-3">
    <div class="max-w-3xl mx-auto flex items-center justify-between gap-3">
      <div class="flex items-center gap-2 min-w-0">
        <span class="material-symbols-outlined text-on-primary-fixed" data-icon="download">download</span>
        <span class="font-label-sm text-label-sm uppercase text-on-primary-fixed truncate">Install SplitSquad</span>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <button id="pwa-install-btn" class="brutalist-border-thin bg-surface-container-lowest px-3 py-1.5 font-label-sm text-label-sm uppercase text-on-surface hover:bg-surface-variant transition-all active:translate-x-[2px] active:translate-y-[2px] active:shadow-none">Install</button>
        <button id="pwa-dismiss-btn" class="p-1 text-on-primary-fixed hover:text-on-primary-container transition-colors">
          <span class="material-symbols-outlined text-4" data-icon="close">close</span>
        </button>
      </div>
    </div>
  </div>
  <main class="flex-1 max-w-3xl w-full mx-auto p-margin-mobile md:p-margin-desktop space-y-6">
    <div class="grid grid-cols-2 gap-gutter">
      <a href="/app/scan-qr" class="brutalist-border brutalist-shadow bg-primary-container p-4 flex flex-col items-center justify-center gap-2 hover:bg-inverse-primary transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">
        <span class="material-symbols-outlined text-4xl" data-icon="qr_code_scanner">qr_code_scanner</span>
        <span class="font-label-md text-label-md uppercase text-center">Scan UPI<br/>QR Code</span>
      </a>
      <a href="/app/contacts" class="brutalist-border brutalist-shadow bg-surface-container p-4 flex flex-col items-center justify-center gap-2 hover:bg-surface-variant transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">
        <span class="material-symbols-outlined text-4xl" data-icon="group_add">group_add</span>
        <span class="font-label-md text-label-md uppercase text-center">Manage<br/>Participants</span>
      </a>
    </div>
    <div class="brutalist-border bg-surface p-6 space-y-6">
      <h2 class="font-headline-lg-mobile text-headline-lg-mobile uppercase border-b border-on-surface pb-2">Create Split</h2>
      <form id="create-split-form" class="space-y-4">
        <div class="flex flex-col gap-1">
          <label class="font-label-md text-label-md uppercase">Split Name</label>
          <input id="description" class="w-full bg-surface-container-lowest brutalist-border-thin p-3 font-body-md focus:outline-none focus:border-[3px] focus:border-primary transition-all rounded-none" placeholder="Dinner, Cab, etc." type="text" required/>
        </div>
        <div id="qr-data-display" class="hidden bg-surface-container-low brutalist-border-thin p-3">
          <div class="flex justify-between items-center">
            <div>
              <p class="font-label-sm text-label-sm uppercase text-on-surface-variant" id="qr-merchant-name"></p>
              <p class="font-label-sm text-label-sm text-outline" id="qr-upi-id"></p>
            </div>
            <button type="button" id="clear-qr-data" class="font-label-sm text-label-sm uppercase text-error">Clear</button>
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <label class="font-label-md text-label-md uppercase">Total Amount (₹)</label>
          <input id="total-amount" class="w-full bg-surface-container-lowest brutalist-border-thin p-3 font-headline-md focus:outline-none focus:border-[3px] focus:border-primary transition-all rounded-none" placeholder="0.00" type="number" step="0.01" min="0.01" required/>
        </div>
        <div class="flex brutalist-border bg-surface-container-low">
          <button type="button" class="payment-mode-btn flex-1 p-3 font-label-sm text-label-sm uppercase bg-primary-container brutalist-border-thin border-r-0 hover:bg-inverse-primary active:bg-primary-container transition-colors" data-mode="creator_paid">I Paid</button>
          <button type="button" class="payment-mode-btn flex-1 p-3 font-label-sm text-label-sm uppercase bg-surface-container-lowest brutalist-border-thin hover:bg-surface-variant transition-colors text-on-surface-variant" data-mode="merchant_direct">Pay Merchant</button>
        </div>
        <div id="selected-participants" class="space-y-2"></div>
        <button type="button" id="open-participants-dialog" class="brutalist-border-thin border-dashed border-on-surface bg-surface-container-low p-6 flex flex-col items-center justify-center gap-2 cursor-pointer hover:bg-surface-variant transition-colors w-full">
          <span class="material-symbols-outlined text-primary text-3xl" data-icon="person_add">person_add</span>
          <span class="font-label-md text-label-md uppercase text-center text-on-surface-variant">Add Participants</span>
        </button>
        <button type="submit" class="w-full brutalist-border brutalist-shadow bg-primary-container p-4 font-label-md text-label-md uppercase text-on-primary-fixed hover:bg-inverse-primary transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none flex justify-center items-center gap-2">
          <span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
          Create Split
        </button>
        <p id="create-split-status" class="font-label-sm text-label-sm text-on-surface-variant"></p>
      </form>
    </div>
    <div class="space-y-4 pt-4">
      <h2 class="font-headline-md text-headline-md uppercase">Recent Splits</h2>
      <div id="splits-container"></div>
      <div id="empty-state" class="brutalist-border-thin p-8 flex flex-col items-center justify-center bg-surface-container-lowest text-center gap-4">
        <span class="material-symbols-outlined text-4xl text-outline" data-icon="receipt_long">receipt_long</span>
        <p class="font-body-md text-body-md text-on-surface-variant">No splits yet. Scan a QR or create one!</p>
      </div>
    </div>
  </main>
  <div id="participants-dialog" class="fixed inset-0 bg-on-surface bg-opacity-50 hidden items-center justify-center z-50 p-4">
    <div class="brutalist-border bg-surface w-full max-w-lg max-h-[85vh] flex flex-col">
      <div class="flex justify-between items-center p-4 border-b-[3px] border-on-surface">
        <h3 class="font-headline-md text-headline-md uppercase">Select Participants</h3>
        <button type="button" id="close-dialog" class="brutalist-border-thin p-1 hover:bg-surface-container-high transition-colors">
          <span class="material-symbols-outlined" data-icon="close">close</span>
        </button>
      </div>
      <div class="flex gap-0 border-b-[3px] border-on-surface overflow-x-auto">
        <button type="button" class="dialog-tab flex-1 px-3 py-3 font-label-sm text-label-sm uppercase brutalist-border-thin border-r-0 bg-primary-container text-on-primary-fixed" data-category="friends">Friends</button>
        <button type="button" class="dialog-tab flex-1 px-3 py-3 font-label-sm text-label-sm uppercase brutalist-border-thin border-r-0 bg-surface-container-lowest text-on-surface-variant hover:bg-surface-variant" data-category="family">Family</button>
        <button type="button" class="dialog-tab flex-1 px-3 py-3 font-label-sm text-label-sm uppercase brutalist-border-thin bg-surface-container-lowest text-on-surface-variant hover:bg-surface-variant" data-category="co-workers">Co-workers</button>
      </div>
      <div class="flex-1 overflow-y-auto">
        <div class="dialog-panel p-4" data-category="friends"></div>
        <div class="dialog-panel hidden p-4" data-category="family"></div>
        <div class="dialog-panel hidden p-4" data-category="co-workers"></div>
      </div>
      <div class="border-t-[3px] border-on-surface p-4 space-y-2">
        <div id="dialog-selected-count" class="font-label-sm text-label-sm text-on-surface-variant">0 selected</div>
        <div class="flex gap-2">
          <button type="button" id="dialog-add-selected" class="flex-1 brutalist-border brutalist-shadow-sm bg-primary-container p-3 font-label-sm text-label-sm uppercase text-on-primary-fixed hover:bg-inverse-primary transition-all active:translate-x-[2px] active:translate-y-[2px] active:shadow-none">Add Them</button>
          <button type="button" id="dialog-add-from-contacts" class="flex-1 brutalist-border brutalist-shadow-sm bg-surface-container-lowest p-3 font-label-sm text-label-sm uppercase hover:bg-surface-variant transition-all active:translate-x-[2px] active:translate-y-[2px] active:shadow-none">Add from Contacts</button>
        </div>
      </div>
    </div>
  </div>
  <nav class="md:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-20 bg-surface px-2 border-t-[3px] border-on-surface">
    <a class="flex flex-col items-center justify-center bg-primary-container text-on-primary-container border-[2px] border-on-surface shadow-[2px_2px_0px_#1a1c1c] scale-105 p-1 min-w-[64px]" href="/app/">
      <span class="material-symbols-outlined filled" data-icon="home">home</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">Home</span>
    </a>
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/scan-qr">
      <span class="material-symbols-outlined" data-icon="qr_code_scanner">qr_code_scanner</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">Scanner</span>
    </a>
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/contacts">
      <span class="material-symbols-outlined" data-icon="groups">groups</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">Squad</span>
    </a>
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/qr">
      <span class="material-symbols-outlined" data-icon="chat">chat</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">WhatsApp</span>
    </a>
  </nav>
  <%- include('partials/tutorial') %>
  <script src="/app/js/analytics.js"></script>
  <script>
    (function() {
      var sa = window.SplitSquadAnalytics;
      if (!sa) return;

      var params = new URLSearchParams(window.location.search);
      var signup = params.get('signup') === '1';
      var login = params.get('login') === '1';
      <% if (typeof userFull !== 'undefined' && userFull) { %>
      var user = <%- JSON.stringify(userFull) %>;
      sa.setUserProperties({
        user_type: 'free',
        signup_method: user.google_id ? 'google' : 'email',
        first_seen_date: user.created_at ? user.created_at.split('T')[0] : ''
      });
      if (signup) {
        sa.track('sign_up_completed', { method: user.google_id ? 'google' : 'email' });
      }
      if (login) {
        var lastLogin = user.last_login ? new Date(user.last_login) : null;
        if (lastLogin) {
          var daysSince = Math.floor((Date.now() - lastLogin.getTime()) / (1000 * 60 * 60 * 24));
          if (daysSince > 0) {
            sa.track('returning_user', { days_since_last_visit: daysSince });
          }
        }
      }
      <% } %>
      if (signup || login) {
        window.history.replaceState({}, document.title, '/app/');
      }
    })();
  </script>
  <script src="/app/js/app.js"></script>
  <script>
    (function() {
      const banner = document.getElementById('pwa-install-banner');
      const installBtn = document.getElementById('pwa-install-btn');
      const dismissBtn = document.getElementById('pwa-dismiss-btn');
      const DISMISSED_KEY = 'splitsquad_pwa_dismissed';

      if (localStorage.getItem(DISMISSED_KEY)) return;

      let deferredPrompt = null;

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        banner.classList.remove('hidden');
        banner.style.display = 'block';
      });

      if ('standalone' in window.navigator && window.navigator.standalone) {
        return;
      }

      if (!('serviceWorker' in navigator)) return;

      navigator.serviceWorker.register('/app/sw.js').catch(() => {});

      installBtn.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        const result = await deferredPrompt.userChoice;
        if (result.outcome === 'accepted') {
          banner.style.display = 'none';
        }
        deferredPrompt = null;
      });

      dismissBtn.addEventListener('click', () => {
        localStorage.setItem(DISMISSED_KEY, '1');
        banner.style.display = 'none';
      });
    })();
  </script>
</body>
</html>
