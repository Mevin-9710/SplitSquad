<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>SplitSquad</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-gray-50 min-h-screen"><header class="bg-green-600 text-white p-6"><div class="max-w-4xl mx-auto flex justify-between items-center"><h1 class="text-2xl font-bold">SplitSquad</h1><div class="text-sm text-right"><div>Creator: <code><%= creatorName || creatorId %></code> | <a class="underline" href="/connect">Connect WhatsApp</a></div><div class="mt-1"><span class="<%= whatsappConnected ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-900' %> px-2 py-1 rounded text-xs font-semibold"><%= whatsappConnected ? 'Connected' : 'Not Connected' %></span></div></div></div></header><main class="max-w-4xl mx-auto px-4 py-8"><section class="bg-white rounded-xl shadow-sm p-4 mb-6"><form method="GET" action="/" class="flex gap-2 items-center"><input name="creatorName" placeholder="Set creator name" value="<%= creatorName || '' %>" class="border rounded px-3 py-2 flex-1"><button type="submit" class="bg-green-600 text-white rounded px-4 py-2">Save Name</button></form></section><% if (!whatsappConnected) { %><section class="bg-green-50 border border-green-200 rounded-xl shadow-sm p-6 mb-8"><h2 class="text-xl font-semibold mb-2">Connect Your WhatsApp First</h2><p class="text-sm text-gray-700 mb-4">Each creator must connect their own WhatsApp before sending split messages.</p><a href="/connect" class="inline-block bg-green-600 text-white rounded-lg px-4 py-2 font-medium">Open QR Connect Page</a></section><% } %><section class="bg-white rounded-xl shadow-md p-6 mb-8"><h2 class="text-xl font-semibold mb-3">Create Split</h2><form id="create-split-form" class="space-y-4"><input id="description" type="text" placeholder="Description" class="border rounded-lg px-3 py-2 w-full" required><input id="total-amount" type="number" step="0.01" min="0.01" placeholder="Total Amount (₹)" class="border rounded-lg px-3 py-2 w-full" required><div class="flex gap-2"><button type="button" id="pick-contacts-btn" class="border rounded-lg px-3 py-2">Pick from Contacts</button><button type="button" id="add-participant-btn" class="border rounded-lg px-3 py-2">Add Manual Participant</button></div><p id="contact-picker-hint" class="text-sm text-gray-600"></p><div id="participants-fields" class="space-y-2"></div><button type="submit" class="bg-green-600 text-white rounded-lg px-4 py-2">Create Split</button><p id="create-split-status" class="text-sm text-gray-600"></p></form></section><h2 class="text-xl font-semibold mb-3">Your Recent Splits</h2><div id="splits-container"></div><div id="empty-state" class="hidden text-gray-500">No splits yet.</div></main><script src="/js/app.js"></script></body></html>
