<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SplitSquad</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <header class="bg-green-600 text-white p-4">
    <div class="max-w-4xl mx-auto flex justify-between items-center">
      <h1 class="text-xl font-bold">SplitSquad</h1>
      <div class="text-xs text-right">
        <div><a class="underline" href="/settings">Settings</a> | <a class="underline" href="/connect">Connect</a></div>
        <div class="mt-1">
          <span class="<%= whatsappConnected ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-900' %> px-2 py-0.5 rounded text-xs font-semibold"><%= whatsappConnected ? 'Connected' : 'Not Connected' %></span>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-6">
    <!-- QR Scanner Entry -->
    <section class="mb-4">
      <a href="/scan-qr" class="flex items-center gap-3 bg-gradient-to-r from-green-600 to-green-500 text-white rounded-xl shadow-md px-5 py-4 hover:from-green-700 hover:to-green-600 transition-all">
        <svg class="w-8 h-8 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
        <div>
          <p class="font-semibold text-lg">Scan UPI QR Code</p>
          <p class="text-xs text-green-100">Scan merchant QR to auto-fill bill details</p>
        </div>
      </a>
    </section>

    <!-- Manage Participants -->
    <section class="mb-4">
      <a href="/contacts" class="flex items-center gap-3 bg-white border border-green-600 text-green-600 rounded-xl shadow-sm px-5 py-3 hover:bg-green-50 transition-colors">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        <span class="font-medium">Manage Participants</span>
      </a>
    </section>

    <!-- Create Split -->
    <section class="bg-white rounded-xl shadow-md p-5 mb-6">
      <h2 class="text-lg font-semibold mb-3">Create Split</h2>
      <form id="create-split-form" class="space-y-3">
        <input id="description" type="text" placeholder="Split name (e.g., Dinner at Cafe)" class="border rounded-lg px-3 py-2 w-full" required>

        <!-- QR Data Display -->
        <div id="qr-data-display" class="hidden bg-green-50 border border-green-200 rounded-lg p-3">
          <div class="flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-green-800" id="qr-merchant-name"></p>
              <p class="text-xs text-green-600" id="qr-upi-id"></p>
            </div>
            <button type="button" id="clear-qr-data" class="text-green-600 text-sm">Clear</button>
          </div>
        </div>

        <input id="total-amount" type="number" step="0.01" min="0.01" placeholder="Total Amount (₹)" class="border rounded-lg px-3 py-2 w-full" required>

        <!-- Payment Mode -->
        <div class="flex gap-2">
          <label class="flex-1 flex items-center gap-2 border rounded-lg px-3 py-2 cursor-pointer has-[:checked]:border-green-600 has-[:checked]:bg-green-50">
            <input type="radio" name="paymentMode" value="creator_paid" checked class="text-green-600">
            <div>
              <p class="text-sm font-medium">I Paid</p>
              <p class="text-xs text-gray-500">Others reimburse me</p>
            </div>
          </label>
          <label class="flex-1 flex items-center gap-2 border rounded-lg px-3 py-2 cursor-pointer has-[:checked]:border-green-600 has-[:checked]:bg-green-50">
            <input type="radio" name="paymentMode" value="merchant_direct" class="text-green-600">
            <div>
              <p class="text-sm font-medium">Pay Merchant</p>
              <p class="text-xs text-gray-500">Everyone pays directly</p>
            </div>
          </label>
        </div>

        <div id="selected-participants" class="space-y-2"></div>

        <button type="button" id="open-participants-dialog" class="w-full border-2 border-dashed border-gray-300 rounded-lg px-4 py-3 text-gray-500 hover:border-green-500 hover:text-green-600 transition-colors flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Add Participants
        </button>

        <button type="submit" class="bg-green-600 text-white rounded-lg px-4 py-2.5 w-full font-medium">Create Split</button>
        <p id="create-split-status" class="text-sm text-gray-600"></p>
      </form>
    </section>

    <!-- Recent Splits -->
    <h2 class="text-lg font-semibold mb-3">Recent Splits</h2>
    <div id="splits-container"></div>
    <div id="empty-state" class="hidden text-gray-500 text-center py-4">No splits yet. Scan a QR or create one!</div>
  </main>

  <!-- Participants Selection Dialog -->
  <div id="participants-dialog" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl w-full max-w-lg max-h-[85vh] flex flex-col">
      <div class="flex justify-between items-center p-4 border-b">
        <h3 class="text-lg font-semibold">Select Participants</h3>
        <button type="button" id="close-dialog" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="flex gap-1 border-b px-4 pt-2 overflow-x-auto">
        <button type="button" class="dialog-tab px-3 py-2 text-sm font-medium border-b-2 border-green-600 text-green-600 whitespace-nowrap" data-category="friends">Friends</button>
        <button type="button" class="dialog-tab px-3 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 whitespace-nowrap" data-category="family">Family</button>
        <button type="button" class="dialog-tab px-3 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 whitespace-nowrap" data-category="co-workers">Co-workers</button>
      </div>

      <div class="flex-1 overflow-y-auto p-4">
        <div class="dialog-panel" data-category="friends"></div>
        <div class="dialog-panel hidden" data-category="family"></div>
        <div class="dialog-panel hidden" data-category="co-workers"></div>
      </div>

      <div class="border-t p-4 space-y-2">
        <div id="dialog-selected-count" class="text-sm text-gray-500">0 selected</div>
        <div class="flex gap-2">
          <button type="button" id="dialog-add-selected" class="flex-1 bg-green-600 text-white rounded-lg px-4 py-2 font-medium">Add Them</button>
          <button type="button" id="dialog-add-from-contacts" class="flex-1 border border-green-600 text-green-600 rounded-lg px-4 py-2 font-medium">Add from Contacts</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
