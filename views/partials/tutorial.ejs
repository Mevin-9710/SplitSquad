<div id="tutorial-overlay">
  <div class="tutorial-highlight"></div>
  <div id="tutorial-tooltip">
    <div class="tooltip-step"></div>
    <div class="tooltip-title"></div>
    <div class="tooltip-body"></div>
    <div class="tooltip-actions">
      <button class="tooltip-btn skip">Skip Tutorial</button>
      <button class="tooltip-btn next">Next</button>
    </div>
  </div>
</div>
<div id="tutorial-welcome">
  <div class="welcome-card">
    <div class="welcome-title"></div>
    <div class="welcome-body"></div>
    <div class="welcome-actions">
      <button class="welcome-btn skip">Skip</button>
      <button class="welcome-btn start">Start Tutorial</button>
    </div>
  </div>
</div>
<script src="/js/tutorial.js"></script>
