<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WhatsApp QR - SplitSquad</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', system-ui, sans-serif; }
  </style>
</head>
<body class="bg-gradient-to-br from-[#25D366] to-[#128C7E] min-h-screen flex items-center justify-center">
  <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md mx-4 text-center">
    <div class="flex items-center justify-center mb-6">
      <img src="/images/logo.svg" alt="SplitSquad" class="w-12 h-12 mr-3">
      <h1 class="text-2xl font-bold text-gray-800">Connect WhatsApp</h1>
    </div>

    <p class="text-gray-600 mb-6">Scan the QR code to link your WhatsApp number</p>

    <div id="qr-container" class="bg-gray-100 rounded-xl p-6 mb-6 min-h-[250px] flex items-center justify-center">
      <div id="qr-placeholder" class="text-gray-500">
        <svg class="w-16 h-16 mx-auto text-gray-300 mb-4 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p id="status-text">Waiting for QR code...</p>
      </div>
      <canvas id="qr-canvas" class="hidden mx-auto"></canvas>
    </div>

    <div id="success-message" class="hidden text-green-600 mb-4">
      <svg class="w-12 h-12 mx-auto text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <p class="mt-2 font-medium">WhatsApp connected!</p>
    </div>

    <a href="/" class="text-[#25D366] hover:text-[#128C7E] font-medium">
      ← Back to Home
    </a>
  </div>

  <script>
    const statusText = document.getElementById('status-text');
    const qrPlaceholder = document.getElementById('qr-placeholder');
    const qrCanvas = document.getElementById('qr-canvas');
    const successMessage = document.getElementById('success-message');

    // Poll for QR code updates
    async function checkQR() {
      try {
        const response = await fetch('/status');
        const data = await response.json();

        if (data.whatsapp === 'connected') {
          // WhatsApp is connected
          qrPlaceholder.classList.add('hidden');
          qrCanvas.classList.add('hidden');
          successMessage.classList.remove('hidden');
          statusText.textContent = 'Connected!';
          return;
        }

        if (data.qr && data.status === 'ok') {
          // Generate QR code image from raw QR data
          statusText.textContent = 'Scan with WhatsApp';
          qrPlaceholder.classList.add('hidden');
          qrCanvas.classList.remove('hidden');

          // Clear and regenerate QR code
          qrCanvas.classList.remove('hidden');
          QRCode.toCanvas(qrCanvas, data.qr, {
            width: 220,
            margin: 2,
            color: {
              dark: '#000000',
              light: '#ffffff'
            }
          }, function(error) {
            if (error) {
              console.error('QR generation error:', error);
              statusText.textContent = 'Error generating QR';
            }
          });
        }
      } catch (error) {
        console.error('Failed to check QR status:', error);
      }
    }

    // Check immediately, then every 2 seconds
    checkQR();
    setInterval(checkQR, 2000);
  </script>
</body>
</html>
