<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>WhatsApp - SplitSquad</title>
  <link href="/app/images/S.svg" rel="icon" type="image/svg+xml"/>
  <link href="/app/css/brutalist.css" rel="stylesheet"/>
  <link href="/app/css/tailwind.css" rel="stylesheet"/>
  <style>
    .brutalist-border { border: 3px solid #1a1c1c; }
    .brutalist-border-thin { border: 1px solid #1a1c1c; }
    .brutalist-shadow { box-shadow: 4px 4px 0px #1a1c1c; }
    .brutalist-shadow-sm { box-shadow: 2px 2px 0px #1a1c1c; }
    .brutalist-shadow:active { box-shadow: none; transform: translate(4px, 4px); }
    body { background-color: #f9f9f9; color: #1a1c1c; }
  </style>
  <style> body { min-height: max(884px, 100dvh); } </style>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="font-body-md bg-background min-h-screen flex flex-col pt-16 pb-20 md:pb-0 grid-bg">
  <%- include('partials/loading') %>
  <header class="fixed top-0 w-full z-50 flex justify-between items-center px-margin-mobile md:px-margin-desktop h-16 bg-surface/90 backdrop-blur-sm text-on-surface border-b-[3px] border-on-surface shadow-brutalist-sm">
    <a href="/app/" class="brutalist-border-thin p-1 hover:bg-primary-container hover:text-on-primary-container transition-colors">
      <span class="material-symbols-outlined" data-icon="arrow_back">arrow_back</span>
    </a>
    <span class="font-headline-md text-headline-md uppercase tracking-tighter">SplitSquad</span>
    <div class="w-10"></div>
  </header>
  <main class="flex-1 max-w-3xl w-full mx-auto p-margin-mobile md:p-margin-desktop space-y-4">
    <h1 class="font-headline-lg-mobile text-headline-lg-mobile uppercase border-b-[3px] border-on-surface pb-2">WhatsApp Connection</h1>
    <div class="brutalist-border bg-surface-container-lowest p-6 text-center">
      <p class="font-label-sm text-label-sm uppercase text-on-surface-variant mb-2">Status</p>
      <p id="state" class="font-headline-md text-headline-md uppercase">Checking...</p>
      <p id="hint" class="font-label-sm text-label-sm text-on-surface-variant mt-2"></p>
    </div>
    <div class="brutalist-border bg-surface-container-low p-8 flex flex-col items-center justify-center">
      <img id="qr-image" class="hidden w-52 h-52 brutalist-border-thin bg-surface-container-lowest" alt="WhatsApp QR code"/>
      <div id="qr-placeholder" class="flex flex-col items-center gap-3">
        <span class="material-symbols-outlined text-6xl text-outline" data-icon="qr_code_2">qr_code_2</span>
        <p class="font-label-md text-label-md uppercase text-on-surface-variant">Connect to get QR code</p>
      </div>
    </div>
    <div class="flex gap-2">
      <button id="connect" class="flex-1 brutalist-border brutalist-shadow bg-primary-container p-4 font-label-md text-label-md uppercase text-on-primary-fixed hover:bg-inverse-primary transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">Connect</button>
      <button id="disconnect" class="flex-1 brutalist-border brutalist-shadow bg-surface-container-lowest p-4 font-label-md text-label-md uppercase hover:bg-surface-variant transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">Disconnect</button>
    </div>
  </main>
  <nav class="md:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-20 bg-surface px-2 border-t-[3px] border-on-surface">
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/">
      <svg class="w-6 h-6 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class="font-label-sm text-label-sm">Home</span>
    </a>
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/scan-qr">
      <svg class="w-6 h-6 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/><path d="M10 10h4v4h-4z"/><path d="M10 3v7M17 3v7M3 10h7M14 10h7"/><path d="M3 17h7M14 17h7"/><path d="M10 14v7M17 14v7"/></svg>
      <span class="font-label-sm text-label-sm">Scan</span>
    </a>
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/contacts">
      <svg class="w-6 h-6 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span class="font-label-sm text-label-sm">Contacts</span>
    </a>
    <a class="flex flex-col items-center justify-center bg-primary-container text-on-primary-container border-[2px] border-on-surface shadow-[2px_2px_0px_#1a1c1c] scale-105 p-1 min-w-[64px]" href="/app/qr">
      <span class="material-symbols-outlined filled" data-icon="chat">chat</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">WhatsApp</span>
    </a>
  </nav>
  <%- include('partials/tutorial') %>
  <script>
    const stateEl = document.getElementById('state');
    const hintEl = document.getElementById('hint');
    const qrImg = document.getElementById('qr-image');
    const placeholder = document.getElementById('qr-placeholder');
    let pollCount = 0;

    async function refresh() {
      try {
        const statusRes = await fetch('/api/evolution/status');
        const status = await statusRes.json();
        if (status.connected) {
          stateEl.textContent = 'Connected';
          stateEl.classList.add('text-primary');
          hintEl.textContent = 'Your WhatsApp is ready to send splits.';
          qrImg.classList.add('hidden');
          placeholder.classList.remove('hidden');
          pollCount = 0;
          return;
        }

        const qrRes = await fetch('/api/evolution/qr-image');
        const qr = await qrRes.json();
        
        if (qr.success && qr.qrImage) {
          qrImg.src = qr.qrImage;
          qrImg.classList.remove('hidden');
          placeholder.classList.add('hidden');
          stateEl.textContent = 'Scan QR Code';
          stateEl.classList.remove('text-primary');
          hintEl.textContent = 'Open WhatsApp > Linked Devices > Link a Device';
          pollCount = 0;
          return;
        }

        qrImg.classList.add('hidden');
        placeholder.classList.remove('hidden');
        
        if (qr.message) {
          stateEl.textContent = 'Not Connected';
          hintEl.textContent = qr.message;
        } else if (qr.error) {
          stateEl.textContent = 'Error';
          hintEl.textContent = typeof qr.error === 'object' ? JSON.stringify(qr.error) : qr.error;
        } else {
          stateEl.textContent = 'Waiting for QR...';
          hintEl.textContent = `Generating QR code... (${++pollCount}s)`;
        }
      } catch (e) {
        stateEl.textContent = 'Error';
        hintEl.textContent = 'Failed to check status. Retrying...';
      }
    }

    document.getElementById('connect').addEventListener('click', async () => {
      try {
        const res = await fetch('/api/evolution/connect', { method: 'POST' });
        const data = await res.json();
        
        if (data.success) {
          stateEl.textContent = 'Connecting...';
          hintEl.textContent = 'Starting WhatsApp client. QR will appear shortly...';
          pollCount = 0;
          setTimeout(refresh, 3000);
        } else {
          stateEl.textContent = 'Failed';
          hintEl.textContent = typeof data.error === 'object' ? JSON.stringify(data.error) : (data.error || 'Connection failed. Try again.');
        }
      } catch (e) {
        stateEl.textContent = 'Error';
        hintEl.textContent = 'Failed to connect. Check server logs.';
      }
    });

    document.getElementById('disconnect').addEventListener('click', async () => {
      try {
        await fetch('/api/evolution/disconnect', { method: 'POST' });
        stateEl.textContent = 'Disconnected';
        hintEl.textContent = 'Tap Connect to generate a new QR code.';
        qrImg.classList.add('hidden');
        placeholder.classList.remove('hidden');
      } catch (e) {
        stateEl.textContent = 'Error';
        hintEl.textContent = 'Failed to disconnect.';
      }
    });

    refresh();
    setInterval(refresh, 5000);
  </script>
</body>
</html>
