<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Connect WhatsApp</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-gray-100 min-h-screen"><main class="max-w-md mx-auto mt-12 bg-white rounded-xl p-6 shadow"><a class="text-green-600" href="/">← Back</a><h1 class="text-xl font-bold mt-2">Creator WhatsApp Connection</h1><p class="text-sm text-gray-600">Creator: <code><%= creatorName || creatorId || 'unknown' %></code></p><p id="state" class="text-sm mt-2">Checking status...</p><img id="qr-image" class="mx-auto my-4 hidden w-[220px] h-[220px] border rounded bg-white" alt="WhatsApp QR code"><p id="hint" class="text-xs text-gray-500 mb-3"></p><div class="flex gap-2"><button id="connect" class="flex-1 border rounded-lg py-2">Retry Connect</button><button id="disconnect" class="flex-1 border rounded-lg py-2">Disconnect</button></div></main><script>const stateEl=document.getElementById('state');const hintEl=document.getElementById('hint');const qrImg=document.getElementById('qr-image');async function refresh(){const statusRes=await fetch('/api/evolution/status');const status=await statusRes.json();if(status.connected){stateEl.textContent='Connected';hintEl.textContent='';qrImg.classList.add('hidden');return;}const qrRes=await fetch('/api/evolution/qr-image');const qr=await qrRes.json();if(qr.success&&qr.qrImage){qrImg.src=qr.qrImage;qrImg.classList.remove('hidden');stateEl.textContent='Scan this QR in WhatsApp linked devices';hintEl.textContent=qr.mode==='evolution'?'Using Evolution API QR':'Using standard WhatsApp QR';return;}qrImg.classList.add('hidden');stateEl.textContent='QR not available yet';hintEl.textContent='Retry in a few seconds.';}document.getElementById('connect').addEventListener('click',refresh);document.getElementById('disconnect').addEventListener('click',async()=>{await fetch('/api/evolution/disconnect',{method:'POST'});await refresh();});refresh();setInterval(refresh,3000);</script></body></html>
