<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Login - SplitSquad</title>
  <link href="/css/brutalist.css" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "tertiary": "#5d5f5f",
            "surface-tint": "#785a00",
            "on-primary": "#ffffff",
            "inverse-on-surface": "#f1f1f1",
            "outline-variant": "#d3c5ad",
            "inverse-surface": "#2f3131",
            "surface-bright": "#f9f9f9",
            "on-primary-fixed-variant": "#5b4300",
            "primary": "#785a00",
            "tertiary-container": "#c4c5c5",
            "surface-container-highest": "#e2e2e2",
            "primary-container": "#f4bd31",
            "on-primary-fixed": "#251a00",
            "on-primary-container": "#694d00",
            "tertiary-fixed-dim": "#c6c6c7",
            "on-tertiary-container": "#505252",
            "surface-container-lowest": "#ffffff",
            "outline": "#817661",
            "inverse-primary": "#f5be32",
            "on-secondary-fixed-variant": "#474747",
            "secondary": "#5e5e5e",
            "surface-dim": "#dadada",
            "secondary-fixed": "#e2e2e2",
            "on-error-container": "#93000a",
            "on-secondary-fixed": "#1b1b1b",
            "surface-container-high": "#e8e8e8",
            "tertiary-fixed": "#e2e2e2",
            "surface-variant": "#e2e2e2",
            "surface-container-low": "#f4f3f3",
            "secondary-container": "#e2e2e2",
            "on-surface": "#1a1c1c",
            "secondary-fixed-dim": "#c6c6c6",
            "on-error": "#ffffff",
            "on-tertiary-fixed": "#1a1c1c",
            "on-tertiary": "#ffffff",
            "primary-fixed-dim": "#f5be32",
            "surface": "#f9f9f9",
            "on-secondary": "#ffffff",
            "on-background": "#1a1c1c",
            "on-tertiary-fixed-variant": "#454747",
            "on-surface-variant": "#4f4634",
            "error": "#ba1a1a",
            "background": "#f9f9f9",
            "surface-container": "#eeeeee",
            "error-container": "#ffdad6",
            "primary-fixed": "#ffdf9d",
            "on-secondary-container": "#646464"
          },
          "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
          "spacing": { "border-width-thin": "1px", "margin-desktop": "32px", "border-width-thick": "3px", "unit": "4px", "margin-mobile": "16px", "gutter": "16px" },
          "fontFamily": { "headline-lg": ["Pixelify Sans", "sans-serif"], "body-md": ["Inter"], "label-sm": ["Space Mono"], "label-md": ["Space Mono"], "headline-lg-mobile": ["Pixelify Sans", "sans-serif"], "headline-md": ["Pixelify Sans", "sans-serif"], "body-lg": ["Inter"] },
          "fontSize": { "headline-lg": ["40px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700"}], "body-md": ["16px", {"lineHeight": "1.6", "fontWeight": "400"}], "label-sm": ["12px", {"lineHeight": "1.0", "fontWeight": "500"}], "label-md": ["14px", {"lineHeight": "1.0", "fontWeight": "500"}], "headline-lg-mobile": ["32px", {"lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700"}], "headline-md": ["24px", {"lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "700"}], "body-lg": ["18px", {"lineHeight": "1.6", "fontWeight": "400"}] }
        }
      }
    }
  </script>
  <style>
    .brutalist-border { border: 3px solid #1a1c1c; }
    .brutalist-border-thin { border: 1px solid #1a1c1c; }
    .brutalist-shadow { box-shadow: 4px 4px 0px #1a1c1c; }
    .brutalist-shadow-sm { box-shadow: 2px 2px 0px #1a1c1c; }
    .brutalist-shadow:active { box-shadow: none; transform: translate(4px, 4px); }
    body { background-color: #f9f9f9; color: #1a1c1c; }
  </style>
  <style> body { min-height: max(884px, 100dvh); } </style>
</head>
<body class="font-body-md bg-background min-h-screen flex flex-col items-center justify-center p-margin-mobile grid-bg">
  <%- include('partials/loading') %>
  <div class="w-full max-w-sm space-y-6">
    <div class="text-center mb-8">
      <div class="inline-block brutalist-border brutalist-shadow bg-primary-container px-6 py-3">
        <span class="font-headline-lg-mobile text-headline-lg-mobile uppercase text-on-primary-fixed">SplitSquad</span>
      </div>
      <p class="font-label-md text-label-md uppercase text-on-surface-variant mt-3">Bill splitting, simplified</p>
    </div>
    <% const urlError = typeof query !== 'undefined' && query.error ? 'Authentication failed. Please try again.' : null; %>
    <% const displayError = error || urlError; %>
    <% if (displayError) { %>
    <div class="brutalist-border-thin border-error bg-error-container p-3">
      <p class="font-label-sm text-label-sm text-error-container"><%= displayError %></p>
    </div>
    <% } %>
    <% if (success) { %>
    <div class="brutalist-border-thin bg-primary-container p-3">
      <p class="font-label-sm text-label-sm text-on-primary-fixed"><%= success %></p>
    </div>
    <% } %>
    <div class="brutalist-border bg-surface-container-lowest p-6 space-y-4">
      <div class="flex brutalist-border bg-surface-container-low mb-4">
        <button id="tab-login" class="flex-1 p-3 font-label-sm text-label-sm uppercase bg-primary-container brutalist-border-thin border-r-0 text-on-primary-fixed">Login</button>
        <button id="tab-register" class="flex-1 p-3 font-label-sm text-label-sm uppercase bg-surface-container-lowest brutalist-border-thin text-on-surface-variant hover:bg-surface-variant">Register</button>
      </div>
      <form id="login-form" action="/auth/login" method="POST" class="space-y-3">
        <div>
          <label class="font-label-sm text-label-sm uppercase">Email</label>
          <input name="email" class="w-full bg-surface-container-lowest brutalist-border-thin p-3 font-body-md focus:outline-none focus:border-[3px] focus:border-primary transition-all rounded-none mt-1" placeholder="you@email.com" type="email" required/>
        </div>
        <div>
          <label class="font-label-sm text-label-sm uppercase">Password</label>
          <input name="password" class="w-full bg-surface-container-lowest brutalist-border-thin p-3 font-body-md focus:outline-none focus:border-[3px] focus:border-primary transition-all rounded-none mt-1" placeholder="Enter password" type="password" required/>
        </div>
        <button type="submit" class="w-full brutalist-border brutalist-shadow bg-primary-container p-4 font-label-md text-label-md uppercase text-on-primary-fixed hover:bg-inverse-primary transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">
          Login
        </button>
      </form>
      <form id="register-form" action="/auth/register" method="POST" class="space-y-3 hidden">
        <div>
          <label class="font-label-sm text-label-sm uppercase">Name</label>
          <input name="name" class="w-full bg-surface-container-lowest brutalist-border-thin p-3 font-body-md focus:outline-none focus:border-[3px] focus:border-primary transition-all rounded-none mt-1" placeholder="Your name" type="text" required/>
        </div>
        <div>
          <label class="font-label-sm text-label-sm uppercase">Email</label>
          <input name="email" class="w-full bg-surface-container-lowest brutalist-border-thin p-3 font-body-md focus:outline-none focus:border-[3px] focus:border-primary transition-all rounded-none mt-1" placeholder="you@email.com" type="email" required/>
        </div>
        <div>
          <label class="font-label-sm text-label-sm uppercase">Password</label>
          <input name="password" class="w-full bg-surface-container-lowest brutalist-border-thin p-3 font-body-md focus:outline-none focus:border-[3px] focus:border-primary transition-all rounded-none mt-1" placeholder="Min 6 characters" type="password" required/>
        </div>
        <button type="submit" class="w-full brutalist-border brutalist-shadow bg-primary-container p-4 font-label-md text-label-md uppercase text-on-primary-fixed hover:bg-inverse-primary transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">
          Register
        </button>
      </form>
    </div>
    <% if (googleEnabled) { %>
    <div class="flex items-center gap-3">
      <div class="flex-1 border-t-[3px] border-on-surface"></div>
      <span class="font-label-sm text-label-sm uppercase text-on-surface-variant">or</span>
      <div class="flex-1 border-t-[3px] border-on-surface"></div>
    </div>
    <a href="/auth/google" class="w-full brutalist-border brutalist-shadow bg-surface-container-lowest p-4 font-label-md text-label-md uppercase flex items-center justify-center gap-2 hover:bg-surface-variant transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">
      <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
      Continue with Google
    </a>
    <% } %>
  </div>
  <%- include('partials/tutorial') %>
  <script>
    document.getElementById('tab-login').addEventListener('click', () => {
      document.getElementById('tab-login').classList.add('bg-primary-container', 'text-on-primary-fixed');
      document.getElementById('tab-login').classList.remove('bg-surface-container-lowest', 'text-on-surface-variant');
      document.getElementById('tab-register').classList.remove('bg-primary-container', 'text-on-primary-fixed');
      document.getElementById('tab-register').classList.add('bg-surface-container-lowest', 'text-on-surface-variant');
      document.getElementById('login-form').classList.remove('hidden');
      document.getElementById('register-form').classList.add('hidden');
    });
    document.getElementById('tab-register').addEventListener('click', () => {
      document.getElementById('tab-register').classList.add('bg-primary-container', 'text-on-primary-fixed');
      document.getElementById('tab-register').classList.remove('bg-surface-container-lowest', 'text-on-surface-variant');
      document.getElementById('tab-login').classList.remove('bg-primary-container', 'text-on-primary-fixed');
      document.getElementById('tab-login').classList.add('bg-surface-container-lowest', 'text-on-surface-variant');
      document.getElementById('register-form').classList.remove('hidden');
      document.getElementById('login-form').classList.add('hidden');
    });
  </script>
</body>
</html>
