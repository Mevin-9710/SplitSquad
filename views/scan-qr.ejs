<!DOCTYPE html>
<html lang="en">
<head>
  <script>window.addEventListener('pageshow',function(e){if(e.persisted)location.reload()})</script>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <meta name="theme-color" content="#f4bd31"/>
  <title>Scan QR - SplitSquad</title>
  <link href="/app/images/S.png" rel="icon" type="image/png"/>
  <link href="/app/css/brutalist.css" rel="stylesheet"/>
  <link href="/app/css/tailwind.css" rel="stylesheet"/>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <style>
    .brutalist-border { border: 3px solid #1a1c1c; }
    .brutalist-border-thin { border: 1px solid #1a1c1c; }
    .brutalist-shadow { box-shadow: 4px 4px 0px #1a1c1c; }
    .brutalist-shadow-sm { box-shadow: 2px 2px 0px #1a1c1c; }
    .brutalist-shadow:active { box-shadow: none; transform: translate(4px, 4px); }
    body { background-color: #f9f9f9; color: #1a1c1c; }
    .grid-bg {
      background-image: linear-gradient(rgba(0,0,0,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.06) 1px, transparent 1px);
      background-size: 20px 20px;
    }
    .scanner-bracket { position: absolute; width: 40px; height: 40px; z-index: 10; }
    .scanner-bracket-tl { top: 0; left: 0; border-top: 4px solid #1a1c1c; border-left: 4px solid #1a1c1c; }
    .scanner-bracket-tr { top: 0; right: 0; border-top: 4px solid #1a1c1c; border-right: 4px solid #1a1c1c; }
    .scanner-bracket-bl { bottom: 0; left: 0; border-bottom: 4px solid #1a1c1c; border-left: 4px solid #1a1c1c; }
    .scanner-bracket-br { bottom: 0; right: 0; border-bottom: 4px solid #1a1c1c; border-right: 4px solid #1a1c1c; }
    .scanner-container { position: relative; overflow: hidden; }
    #qr-reader { position: absolute !important; inset: 0 !important; width: 100% !important; height: 100% !important; z-index: 1; }
    #qr-reader video { width: 100% !important; height: 100% !important; object-fit: cover !important; border-radius: 0 !important; }
    #qr-reader__scan_region { min-height: 100% !important; max-height: none !important; overflow: hidden !important; }
    #qr-reader__dashboard { display: none !important; }
    #qr-reader img[alt="Info icon"] { display: none !important; }
    #qr-reader a { display: none !important; }
    #scanner-placeholder { position: absolute; inset: 0; z-index: 5; }
  </style>
  <style> body { min-height: max(884px, 100dvh); } </style>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="font-body-md bg-background min-h-screen flex flex-col pt-16 pb-20 md:pb-0 grid-bg">
  <%- include('partials/loading') %>
  <header class="fixed top-0 w-full z-50 flex justify-between items-center px-margin-mobile md:px-margin-desktop h-16 bg-surface/90 backdrop-blur-sm text-on-surface border-b-[3px] border-on-surface shadow-brutalist-sm">
    <a href="/app/" class="brutalist-border-thin p-1 hover:bg-primary-container hover:text-on-primary-container transition-colors">
      <span class="material-symbols-outlined" data-icon="arrow_back">arrow_back</span>
    </a>
    <span class="font-headline-md text-headline-md uppercase tracking-tighter">SplitSquad</span>
    <div class="w-10"></div>
  </header>
  <main class="flex-1 max-w-3xl w-full mx-auto p-margin-mobile md:p-margin-desktop flex flex-col items-center justify-center">
    <div class="text-center mb-8">
      <div class="inline-block brutalist-border brutalist-shadow bg-primary-container px-6 py-2 mb-2">
        <span class="font-headline-lg-mobile text-headline-lg-mobile uppercase text-on-primary-fixed">Scan UPI</span>
      </div>
      <div class="inline-block brutalist-border bg-surface-container-lowest px-6 py-1">
        <span class="font-headline-md text-headline-md uppercase">QR Code</span>
      </div>
    </div>
    <div class="scanner-container brutalist-border brutalist-shadow bg-surface-container-low w-full max-w-sm aspect-square relative mb-8">
      <div class="scanner-bracket scanner-bracket-tl"></div>
      <div class="scanner-bracket scanner-bracket-tr"></div>
      <div class="scanner-bracket scanner-bracket-bl"></div>
      <div class="scanner-bracket scanner-bracket-br"></div>
      <div id="qr-reader"></div>
      <div id="scanner-placeholder" class="flex flex-col items-center justify-center">
        <span class="material-symbols-outlined text-6xl text-outline mb-2" data-icon="qr_code_scanner">qr_code_scanner</span>
        <p class="font-label-md text-label-md uppercase text-on-surface-variant">Tap 'Start Scanner' to begin</p>
      </div>
    </div>
    <button id="start-scanner" class="brutalist-border brutalist-shadow bg-primary-container px-8 py-4 font-label-md text-label-md uppercase text-on-primary-fixed hover:bg-inverse-primary transition-all active:translate-x-[4px] active:translate-y-[4px] active:shadow-none">
      Start Scanner
    </button>
    <p id="scan-status" class="font-label-sm text-label-sm text-on-surface-variant mt-4 text-center"></p>
  </main>
  <nav class="md:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-20 bg-surface px-2 border-t-[3px] border-on-surface">
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/">
      <span class="material-symbols-outlined filled" data-icon="home">home</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">Home</span>
    </a>
    <a class="flex flex-col items-center justify-center bg-primary-container text-on-primary-container border-[2px] border-on-surface shadow-[2px_2px_0px_#1a1c1c] scale-105 p-1 min-w-[64px]" href="/app/scan-qr">
      <span class="material-symbols-outlined" data-icon="qr_code_scanner">qr_code_scanner</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">Scanner</span>
    </a>
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/contacts">
      <span class="material-symbols-outlined" data-icon="groups">groups</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">Squad</span>
    </a>
    <a class="flex flex-col items-center justify-center text-on-surface-variant grayscale hover:bg-surface-container-high p-2 min-w-[64px]" href="/app/qr">
      <span class="material-symbols-outlined" data-icon="chat">chat</span>
      <span class="font-label-sm text-label-sm uppercase mt-1">WhatsApp</span>
    </a>
  </nav>
  <%- include('partials/tutorial') %>
  <script>
    let html5QrCode = null;
    let scanning = false;

    document.getElementById('start-scanner').addEventListener('click', async function() {
      const statusEl = document.getElementById('scan-status');
      const placeholder = document.getElementById('scanner-placeholder');

      if (scanning) {
        if (html5QrCode) {
          await html5QrCode.stop();
          scanning = false;
          placeholder.classList.remove('hidden');
          this.textContent = 'Start Scanner';
          statusEl.textContent = '';
        }
        return;
      }

      try {
        html5QrCode = new Html5Qrcode("qr-reader");
        placeholder.classList.add('hidden');
        statusEl.textContent = 'Starting camera...';

        await html5QrCode.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: { width: 250, height: 250 } },
          (decodedText) => {
            handleScannedResult(decodedText);
          },
          (errorMessage) => {}
        );

        scanning = true;
        this.textContent = 'Stop Scanner';
        statusEl.textContent = 'Point camera at UPI QR code';
      } catch (err) {
        statusEl.textContent = 'Camera access denied. Please allow camera permission.';
        placeholder.classList.remove('hidden');
      }
    });

    function handleScannedResult(decodedText) {
      const statusEl = document.getElementById('scan-status');
      statusEl.textContent = 'QR detected! Processing...';

      if (html5QrCode && scanning) {
        html5QrCode.stop();
        scanning = false;
      }

      let upiData = null;
      if (decodedText.startsWith('upi://')) {
        const url = new URL(decodedText);
        upiData = {
          pa: url.searchParams.get('pa'),
          pn: url.searchParams.get('pn'),
          am: url.searchParams.get('am'),
          cu: url.searchParams.get('cu') || 'INR',
          tn: url.searchParams.get('tn'),
        };
      }

      if (upiData && upiData.pa) {
        window.location.href = `/app/?upi_pa=${encodeURIComponent(upiData.pa)}&upi_pn=${encodeURIComponent(upiData.pn || '')}&upi_am=${encodeURIComponent(upiData.am || '')}&upi_cu=${encodeURIComponent(upiData.cu || 'INR')}&upi_tn=${encodeURIComponent(upiData.tn || '')}`;
      } else {
        statusEl.textContent = 'Not a valid UPI QR code. Try again.';
        document.getElementById('scanner-placeholder').classList.remove('hidden');
        document.getElementById('start-scanner').textContent = 'Start Scanner';
      }
    }
  </script>
</body>
</html>
